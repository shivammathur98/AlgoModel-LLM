{
  "ConnectionStrings": {
    "AlgoTrader": "Server=(localdb)\\mssqllocaldb;Database=AlgoTrader;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Trading": {
    "Mode": "Backtest",
    "EnableLiveTrading": false,
    "LiveTradingAcknowledgement": "",
    "StartingCapital": 525000
  },
  "Risk": {
    "MaxCapitalPerTrade": 100000,
    "MaxCapitalUtilizationPercent": 60,
    "MaxSimultaneousPositions": 5,
    "MaxRiskPerTrade": 1500,
    "MaxDailyLoss": 5000,
    "MaxTradesPerDay": 10,
    "MaxOpenOrders": 10,
    "MaxExposurePerSymbol": 100000,
    "MarketDataStaleAfterSeconds": 30,
    "FlattenPositionsOnDailyLossBreach": true,
    "RequireManualResetAfterHalt": true
  },
  "Broker": {
    "Provider": "Zerodha",
    "Environment": "Paper",
    "ApiKey": "",
    "ApiSecret": "",
    "AccessToken": "",
    "RedirectUrl": "http://127.0.0.1:5080/kite/callback",
    "RequestTimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "MarketData": {
    "Exchange": "NSE",
    "Segment": "EQ",
    "DefaultTimeframe": "Minute5",
    "HistoricalFetchPageSize": 100,
    "Universe": {
      "Symbols": [],
      "MaxPrice": 500,
      "MinPrice": 10,
      "MinAverageDailyVolume": 500000,
      "MaxSymbols": 20
    }
  },
  "Strategy": {
    "Name": "MomentumBreakoutV1",
    "Version": "1.0.0",
    "Timeframe": "Minute5",
    "LookbackBars": 10,
    "VolumeMultiplier": 1.5,
    "EmaPeriod": 20,
    "UseTrendFilter": true,
    "StopLossPercent": 0.50,
    "TargetPercent": 1.00,
    "UseTrailingStop": false,
    "MaximumHoldingMinutes": 120,
    "MaxTradesPerDay": 3,
    "EntryStartTime": "09:20",
    "EntryCutoffTime": "14:30",
    "ExitTime": "15:15"
  },
  "Backtest": {
    "InitialCapital": 525000,
    "DataStartUtc": null,
    "DataEndUtc": null,
    "TrainEndUtc": null,
    "ValidationEndUtc": null,
    "ExecutionModel": "Realistic"
  },
  "Costs": {
    "BrokerageFlatPerExecutedOrder": 20,
    "BrokeragePercent": 0.0003,
    "BrokerageMethod": "MinOfFlatAndPercent",
    "SttPercentSell": 0.00025,
    "ExchangeTransactionChargePercent": 0.0000297,
    "SebiChargePercent": 0.000001,
    "StampDutyPercentBuy": 0.00003,
    "GstPercent": 0.18,
    "DpChargePerDeliverySell": 13.5,
    "DpChargeGstPercent": 0.18
  },
  "Slippage": {
    "Model": "Realistic",
    "EntrySlippageBps": 5,
    "ExitSlippageBps": 5,
    "AssumedSpreadBps": 3,
    "HonorLimitPrices": true
  },
  "Logging": {
    "MinimumLevel": "Information",
    "ConsoleEnabled": true,
    "FileEnabled": true,
    "FilePath": "logs/algotrader-.log",
    "AuditLogPath": "logs/audit/algotrader-audit-.log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/algotrader-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
  },
  "AllowedHosts": "*"
}
